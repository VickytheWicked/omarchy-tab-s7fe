# Kernel for Samsung Galaxy Tab S7 FE LTE (SM-T735), SM7225.
#
# Based on vishalbala-nps/linux (fork of sm6350-mainline/linux), `panel` branch,
# which carries sm7225-samsung-gts7xllite.dts and the FT8203 panel driver.
# Touchscreen driver and panel fixes come from
# Marker284/samsung-gts7xllite-display-touch. Config starts from
# linux-postmarketos-qcom-sm6350 (same 7.2 base).
maintainer="Vansh <rupeshvansh84@gmail.com>"
_flavor="samsung-gts7xllite"
pkgname=linux-$_flavor
pkgver=7.2.0
pkgrel=5
pkgdesc="Mainline kernel fork for Samsung Galaxy Tab S7 FE LTE (SM7225)"
arch="aarch64"
_carch="arm64"
url="https://github.com/vishalbala-nps/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	installkernel
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	python3
	zstd
"

# Tip of the `panel` branch: "Disable PPS as Panel is not using it anyways"
_commit="bc46d64b51988485fbaafdb24a80e3148bf1f0a3"
_config="config-$_flavor.$arch"

source="
	linux-$_commit.tar.gz::https://github.com/vishalbala-nps/linux/archive/$_commit.tar.gz
	$_config
	0001-input-add-focaltech-ft8203-touchscreen.patch
	0002-drm-panel-ft8203-stability-fixes.patch
	0003-arm64-dts-gts7xllite-spi6-touchscreen-usb-peripheral.patch
	0004-drm-panel-ft8203-dsc-block-prediction-off.patch
	0005-arm64-dts-gts7xllite-pmk8350-sid-6.patch
	0006-power-supply-add-sm5714-fuel-gauge.patch
	0007-arm64-dts-gts7xllite-otg-role-switch.patch
	0008-power-supply-sm5714-charger-control.patch
"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare
	cp "$srcdir"/$_config .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	# GZIP'd kernel image for boot.img (header v2, Samsung ABL)
	install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

