From 768aaa12a2da8bdf8dc1d9e306681a365bca8aaa Mon Sep 17 00:00:00 2001
From: Mark <3333743.com@gmail.com>
Date: Sat, 24 Oct 2026 21:49:33 +0530
Subject: [PATCH 2/3] drm/panel: ft8203: keep panel powered, send brightness in
 LP mode, send PPS

From Marker284/samsung-gts7xllite-display-touch @ 7587a54.
---
 .../drm/panel/panel-ft8203-ts124qdm-wqxga.c   | 96 ++++++++++++-------
 1 file changed, 63 insertions(+), 33 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-ft8203-ts124qdm-wqxga.c b/drivers/gpu/drm/panel/panel-ft8203-ts124qdm-wqxga.c
index 428ecb9..8437ebe 100644
--- a/drivers/gpu/drm/panel/panel-ft8203-ts124qdm-wqxga.c
+++ b/drivers/gpu/drm/panel/panel-ft8203-ts124qdm-wqxga.c
@@ -11,6 +11,7 @@
 #include <linux/regulator/consumer.h>
 
 #include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
 
 /*
  * DSC in DSI video mode is the least exercised path in msm; allow turning it off
@@ -40,6 +41,19 @@ static int slice_per_pkt = 2;
 module_param(slice_per_pkt, int, 0644);
 MODULE_PARM_DESC(slice_per_pkt, "DSC slices per DSI packet (stock uses 2)");
 
+/*
+ * Powering the panel down and back up wedges the SoC. At boot the bootloader
+ * has already raised every rail, so the first prepare() only adds references
+ * and the init sequence lands on a live DDIC. A later unprepare() really cuts
+ * the rails, and the cold start that follows ends in DSI timeout and FIFO
+ * errors (dsi_err_worker: status=5) and a stalled pipeline; this is what kills
+ * the tablet on every compositor handover, i.e. on login. Until the power-on
+ * sequencing matches downstream, keep the panel powered once it is up.
+ */
+static bool keep_powered = true;
+module_param(keep_powered, bool, 0644);
+MODULE_PARM_DESC(keep_powered, "never power the panel down once it is on");
+
 #include <drm/drm_mipi_dsi.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
@@ -81,6 +95,7 @@ static int ft8203_ts124qdm_wqxga_on(struct ft8203_ts124qdm_wqxga *ctx)
 {
 	struct mipi_dsi_device *dsi = ctx->dsi;
 	struct device *dev = &dsi->dev;
+	struct drm_dsc_picture_parameter_set pps;
 	int ret;
 
 	dsi_dcs_write_seq(dsi, 0x00, 0x00);
@@ -428,19 +443,41 @@ static int ft8203_ts124qdm_wqxga_on(struct ft8203_ts124qdm_wqxga *ctx)
 	msleep(128);
 
 	/*
-	 * No PPS or compression-mode command: the stock kernel sends neither
-	 * (samsung,no_qcom_pps, nothing in the on-commands). The DDIC takes its
-	 * DSC parameters from the vendor B4 bank in the init sequence above, so
-	 * ctx->dsc must stay consistent with those values.
+	 * The DDIC needs the DSC picture parameter set from us: the stock device
+	 * tree sets samsung,no_qcom_pps, so the controller does not generate it.
+	 * msm fills in the derived fields of ctx->dsc while bringing the link
+	 * up, so the config is complete by the time we get here.
 	 */
 	if (no_dsc) {
+		/*
+		 * The init sequence above comes from the stock device tree,
+		 * which runs this panel compressed, so the DDIC is left
+		 * expecting a compressed stream. Tell it otherwise, or it
+		 * decodes our uncompressed pixels as garbage.
+		 */
 		ret = mipi_dsi_compression_mode(dsi, false);
 		if (ret < 0) {
 			dev_err(dev, "Failed to disable compression: %d\n", ret);
 			return ret;
 		}
+		goto skip_dsc;
 	}
 
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+
+	ret = mipi_dsi_picture_parameter_set(dsi, &pps);
+	if (ret < 0) {
+		dev_err(dev, "Failed to send PPS: %d\n", ret);
+		return ret;
+	}
+
+	ret = mipi_dsi_compression_mode(dsi, true);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable compression: %d\n", ret);
+		return ret;
+	}
+
+skip_dsc:
 	ret = mipi_dsi_dcs_set_display_on(dsi);
 	if (ret < 0) {
 		dev_err(dev, "Failed to set display on: %d\n", ret);
@@ -507,6 +544,10 @@ static int ft8203_ts124qdm_wqxga_unprepare(struct drm_panel *panel)
 	if (!ctx->prepared)
 		return 0;
 
+	/* Leave it prepared, so the next prepare() finds it running. */
+	if (keep_powered)
+		return 0;
+
 	ret = ft8203_ts124qdm_wqxga_off(ctx);
 	if (ret < 0)
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
@@ -557,45 +598,34 @@ static const struct drm_panel_funcs ft8203_ts124qdm_wqxga_panel_funcs = {
 	.get_modes = ft8203_ts124qdm_wqxga_get_modes,
 };
 
+/*
+ * Brightness goes out as a low-power DCS write, as the stock driver does
+ * (pwm_cmds->state = DSI_CMD_SET_STATE_LP). Sent in high speed in the middle
+ * of the video stream it trips DSI timeout and FIFO errors
+ * (dsi_err_worker: status=5), and a quick run of them, such as the fade the
+ * desktop plays when it dims the screen, wedges the SoC.
+ */
 static int ft8203_ts124qdm_wqxga_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
 	u16 brightness = backlight_get_brightness(bl);
+	unsigned long flags = dsi->mode_flags;
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_set_display_brightness(dsi, brightness);
-	if (ret < 0)
-		return ret;
+	dsi->mode_flags = flags;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return 0;
-}
-
-// TODO: Check if /sys/class/backlight/.../actual_brightness actually returns
-// correct values. If not, remove this function.
-static int ft8203_ts124qdm_wqxga_bl_get_brightness(struct backlight_device *bl)
-{
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness;
-	int ret;
-
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	ret = mipi_dsi_dcs_get_display_brightness(dsi, &brightness);
-	if (ret < 0)
-		return ret;
-
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return brightness;
+	return ret < 0 ? ret : 0;
 }
 
+/*
+ * No get_brightness: reading the level back is a DCS read, and the bus
+ * turnaround it needs in the middle of the video stream times out. Without
+ * it the core reports the level it last set.
+ */
 static const struct backlight_ops ft8203_ts124qdm_wqxga_bl_ops = {
 	.update_status = ft8203_ts124qdm_wqxga_bl_update_status,
-	.get_brightness = ft8203_ts124qdm_wqxga_bl_get_brightness,
 };
 
 static struct backlight_device *
@@ -659,7 +689,7 @@ static int ft8203_ts124qdm_wqxga_probe(struct mipi_dsi_device *dsi)
 	ctx->dsc.slice_count = 2;
 	ctx->dsc.bits_per_component = 8;
 	ctx->dsc.bits_per_pixel = 8 << 4;
-	ctx->dsc.block_pred_enable = false;
+	ctx->dsc.block_pred_enable = true;
 	if (!no_dsc) {
 		dsi->dsc = &ctx->dsc;
 		dsi->dsc_slice_per_pkt = slice_per_pkt;
@@ -730,4 +760,4 @@ module_mipi_dsi_driver(ft8203_ts124qdm_wqxga_driver);
 
 MODULE_AUTHOR("linux-mdss-dsi-panel-driver-generator <fix@me>"); // FIXME
 MODULE_DESCRIPTION("DRM driver for ss_dsi_panel_FT8203_TS124QDM_WQXGA");
-MODULE_LICENSE("GPL v2");
\ No newline at end of file
+MODULE_LICENSE("GPL v2");
-- 
2.55.0

