# Samsung Galaxy Tab S7 FE LTE (SM-T735), SM7225 "lagoon".
# The Wi-Fi variant (SM-T733 / SM-T730) is SM7325 and is a separate port.

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy Tab S7 FE LTE"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-gts7xllite"
deviceinfo_year="2021"
deviceinfo_dtb="qcom/sm7225-samsung-gts7xllite"
deviceinfo_append_dtb="true"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_drm="true"
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"
# Panel is 2560x1600 but mounted in portrait: native mode is 1600x2560.
deviceinfo_screen_width="1600"
