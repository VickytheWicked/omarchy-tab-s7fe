#!/bin/bash
# Omarchy-style menu for the tablet, generated by gen-tablet-menu.py from the
# laptop's omarchy-menu.jsonc (icons and labels) with tablet actions.
# usage: tablet-menu [route]   e.g. tablet-menu system, tablet-menu trigger.capture
# Escape goes back to the parent menu; at the top it closes.

declare -A ICON LABEL ACTION
declare -a ORDER
add() { ORDER+=("$1"); ICON[$1]=$2; LABEL[$1]=$3; ACTION[$1]=$4; }

add apps '󰀻' Apps tablet-apps
add learn '󰧑' Learn ''
add learn.keybindings '' Keybindings tablet-keybindings
add learn.omarchy '' Omarchy 'chromium --app=https://omarchy.org/manual/'
add learn.hyprland '' Hyprland 'chromium --app=https://wiki.hypr.land/'
add learn.alpine '' Alpine 'chromium --app=https://wiki.alpinelinux.org/'
add learn.postmarketos '󰙯' postmarketOS 'chromium --app=https://wiki.postmarketos.org/'
add learn.neovim '' Neovim 'chromium --app=https://www.lazyvim.org/keymaps'
add learn.bash '󱆃' Bash 'chromium --app=https://devhints.io/bash'
add trigger '󱓞' Trigger ''
add trigger.capture '' Capture ''
add trigger.capture.screenshot '' 'Screenshot (region)' 'tablet-screenshot region'
add trigger.capture.full '' 'Screenshot (full screen)' 'tablet-screenshot full'
add trigger.capture.color '󰃉' Color 'pkill hyprpicker || hyprpicker -a'
add trigger.toggle '󰔎' Toggle ''
add trigger.toggle.idle-lock '󰅶' 'Stay Awake' 'tablet-toggle idle'
add trigger.toggle.notifications '󰂛' Notifications 'tablet-toggle notifications'
add trigger.toggle.nightlight '󰔎' Nightlight tablet-nightlight-toggle
add trigger.toggle.window-gaps '' 'Window Gaps' 'tablet-toggle gaps'
add trigger.hardware '' Hardware ''
add trigger.hardware.usb-host '󰆽' 'USB: host mode (keyboard/mouse)' 'tablet-usb-mode host'
add trigger.hardware.usb-device '󰛧' 'USB: device mode (laptop cable)' 'tablet-usb-mode device'
add style '' Style ''
add style.theme '󰸌' 'Theme (Tokyo Night)' 'notify-send '"'"'Theme'"'"' '"'"'Tokyo Night is the theme on the tablet'"'"''
add style.background '' Background tablet-background
add style.hyprland '' Hyprland 'codium ~/.config/hypr/hyprland.conf'
add setup '' Setup ''
add setup.wifi '󱚾' Wi-Fi nm-connection-editor
add setup.bluetooth '󰂯' Bluetooth blueman-manager
add setup.audio '' Audio 'alacritty -e wiremix'
add setup.monitors '󰍹' Monitors 'codium ~/.config/hypr/hyprland.conf'
add setup.keybindings '' Keybindings 'codium ~/.config/hypr/hyprland.conf'
add setup.input '' Input 'codium ~/.config/hypr/hyprland.conf'
add setup.config '' Config ''
add setup.config.hyprland '' Hyprland 'codium ~/.config/hypr/hyprland.conf'
add setup.config.hypridle '' Hypridle 'codium ~/.config/hypr/hypridle.conf'
add setup.config.waybar '󰍜' Waybar 'codium ~/.config/waybar'
add setup.config.alacritty '' Alacritty 'codium ~/.config/alacritty/alacritty.toml'
add install '󰉉' Install ''
add install.package '' Package 'alacritty -e tablet-pkg-install'
add install.editor '' Editor ''
add install.editor.vscodium '' VSCodium 'alacritty -e bash -c '"'"'sudo apk add vscodium; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.editor.neovim '' Neovim 'alacritty -e bash -c '"'"'sudo apk add neovim; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.editor.helix '' Helix 'alacritty -e bash -c '"'"'sudo apk add helix; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.editor.vim '' Vim 'alacritty -e bash -c '"'"'sudo apk add gvim; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.browser '' Browser ''
add install.browser.firefox '' Firefox 'alacritty -e bash -c '"'"'sudo apk add firefox; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.browser.chromium '' Chromium 'alacritty -e bash -c '"'"'sudo apk add chromium; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development '󰵮' Development ''
add install.development.node '' Node.js 'alacritty -e bash -c '"'"'sudo apk add nodejs npm; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.deno '' Deno 'alacritty -e bash -c '"'"'sudo apk add deno; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.python '' Python 'alacritty -e bash -c '"'"'sudo apk add python3 py3-pip; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.go '' Go 'alacritty -e bash -c '"'"'sudo apk add go; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.rust '' Rust 'alacritty -e bash -c '"'"'sudo apk add rust cargo; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.zig '' Zig 'alacritty -e bash -c '"'"'sudo apk add zig; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.java '' Java 'alacritty -e bash -c '"'"'sudo apk add openjdk21; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.dotnet '' .NET 'alacritty -e bash -c '"'"'sudo apk add dotnet9-sdk; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.php '' PHP 'alacritty -e bash -c '"'"'sudo apk add php83; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.ruby '󰫏' Ruby 'alacritty -e bash -c '"'"'sudo apk add ruby; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.development.elixir '' Elixir 'alacritty -e bash -c '"'"'sudo apk add elixir; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.font '' Font ''
add install.font.cascadia '' 'Cascadia Mono' 'alacritty -e bash -c '"'"'sudo apk add font-cascadia; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.font.meslo '' 'Meslo LG Mono' 'alacritty -e bash -c '"'"'sudo apk add font-meslo-nerd; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add install.font.fira '' 'Fira Code' 'alacritty -e bash -c '"'"'sudo apk add font-fira-code-nerd; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add remove '󰭌' Remove ''
add remove.package '' Package 'alacritty -e tablet-pkg-remove'
add update '' Update ''
add update.system '' System 'alacritty -e bash -c '"'"'tablet-update; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add update.process '' Process ''
add update.process.bar '󰍜' Bar 'pkill -x waybar'
add update.process.hyprsunset '' Hyprsunset 'tablet-toggle restart-nightlight'
add update.hardware '󰇅' Hardware ''
add update.hardware.audio '' Audio 'pkill -x wireplumber; pkill -x pipewire-pulse; pkill -x pipewire; setsid -f /usr/libexec/pipewire-launcher'
add update.hardware.wifi '󱚾' Wi-Fi 'nmcli radio wifi off; sleep 2; nmcli radio wifi on; notify-send '"'"'Wi-Fi'"'"' '"'"'Restarted'"'"''
add update.hardware.bluetooth '󰂯' Bluetooth 'sudo -n rc-service bluetooth restart && notify-send '"'"'Bluetooth'"'"' '"'"'Restarted'"'"''
add update.time '' Time 'sudo -n chronyc -a makestep && notify-send '"'"'Time'"'"' "$(date '"'"'+%A %H:%M'"'"')"'
add about '' About 'alacritty -e bash -c '"'"'fastfetch; echo; read -n 1 -s -r -p "Done! Press any key to close..."'"'"''
add system '' System ''
add system.lock '' 'Lock (needs a keyboard)' 'pidof hyprlock || hyprlock'
add system.logout '󰍃' Logout 'hyprctl dispatch exit'
add system.reboot '󰜉' Reboot 'sudo -n reboot'
add system.shutdown '󰐥' 'Shutdown (unplug USB first)' 'sudo -n poweroff'

children() {
  local parent=$1 id rest
  for id in "${ORDER[@]}"; do
    if [[ -z $parent ]]; then
      [[ $id != *.* ]] && echo "$id"
    else
      rest=${id#"$parent."}
      [[ $id == "$parent."* && $rest != *.* ]] && echo "$id"
    fi
  done
}

title_of() { [[ -z $1 ]] && echo "Go" || echo "${LABEL[$1]}"; }

run() {
  setsid -f bash -c "$1" >/dev/null 2>&1
}

# Toggle like Omarchy: invoking the menu while it is open closes it (any level).
pidfile=${XDG_RUNTIME_DIR:-$HOME/.cache}/tablet-menu.pid
if [[ -f $pidfile ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
  kill "$(cat "$pidfile")" 2>/dev/null
  pkill -x fuzzel
  rm -f "$pidfile"
  exit 0
fi
pkill -x fuzzel
echo $$ > "$pidfile"
trap 'rm -f "$pidfile"' EXIT

back_icon=$'\U000f004d'
close_icon=$'\U000f0156'
route=${1:-}

while true; do
  if [[ -n $route && -n ${ACTION[$route]:-} ]]; then
    run "${ACTION[$route]}"
    exit 0
  fi
  mapfile -t ids < <(children "$route")
  [[ ${#ids[@]} -eq 0 ]] && exit 1
  # Touch has no Escape key, and taps outside fuzzel do not reach the bar while
  # it is open: every menu gets Close on top, submenus also get Back.
  if [[ -n $route ]]; then ids=(__close__ __back__ "${ids[@]}"); else ids=(__close__ "${ids[@]}"); fi
  idx=$(for id in "${ids[@]}"; do
          case $id in
            __close__) printf '%s  Close\n' "$close_icon" ;;
            __back__) printf '%s  Back\n' "$back_icon" ;;
            *) printf '%s  %s\n' "${ICON[$id]}" "${LABEL[$id]}" ;;
          esac
        done | fuzzel --dmenu --index --prompt "$(title_of "$route")  " --lines "${#ids[@]}" --width 42)
  # fuzzel prints -1 (or the typed text) when Enter matches nothing: never let
  # that index into ids[] (ids[-1] in the System menu is Shutdown)
  [[ -z $idx || ( $idx =~ ^[0-9]+$ && $idx -lt ${#ids[@]} ) ]] || exit 0
  [[ -n $idx && ${ids[$idx]} == __close__ ]] && exit 0
  if [[ -z $idx || ${ids[$idx]} == __back__ ]]; then
    [[ -z $route ]] && exit 0
    [[ $route == *.* ]] && route=${route%.*} || route=""
    continue
  fi
  route=${ids[$idx]}
done
