#!/bin/bash
# App launcher with a Close row (fuzzel's own drun list has no way to close by
# touch: taps outside fuzzel never reach the bar while it is open).
pkill -x fuzzel
declare -a names execs terms
while IFS=$'\t' read -r name icon exec term; do
  names+=("$name"); execs+=("$exec"); terms+=("$term"); icons+=("$icon")
done < <(
  for f in ~/.local/share/applications/*.desktop /usr/share/applications/*.desktop; do
    [ -f "$f" ] || continue
    awk -F= '
      /^\[/ { main = ($0 == "[Desktop Entry]") ; next }
      !main { next }
      $1=="Name" && !name { name=substr($0, 6) }
      $1=="Icon" && !icon { icon=substr($0, 6) }
      $1=="Exec" && !exec { exec=substr($0, 6) }
      $1=="Terminal" { term=$2 }
      $1=="NoDisplay" && $2=="true" { hide=1 }
      $1=="Hidden" && $2=="true" { hide=1 }
      $1=="Type" && $2!="Application" { hide=1 }
      END { if (name ~ /^electron[0-9]*$/) hide=1; if (name && exec && !hide) printf "%s\t%s\t%s\t%s\n", name, icon, exec, term }
    ' "$f"
  done | sort -f -u -t$'\t' -k1,1
)
idx=$( {
  printf '%s  Close\0icon\x1fwindow-close\n' $'\U000f0156'
  for i in "${!names[@]}"; do printf '%s\0icon\x1f%s\n' "${names[$i]}" "${icons[$i]}"; done
} | fuzzel --dmenu --index --prompt "Apps  " --lines 12 --width 42 )
[[ -z $idx || $idx == 0 ]] && exit 0
i=$((idx - 1))
cmd=$(sed -E 's/ ?%[fFuUdDnNickvm]//g' <<< "${execs[$i]}")
[[ ${terms[$i]} == true ]] && cmd="alacritty -e $cmd"
setsid -f bash -c "$cmd" >/dev/null 2>&1
