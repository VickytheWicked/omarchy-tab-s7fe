#!/usr/bin/env python3
# Hide squeekboard when focus leaves every window (empty workspace, last window
# closed). Apps that vanish while a text field is focused never tell the
# keyboard to hide, so it would stay up over an empty desktop.
import os, socket, subprocess, time

sock = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr",
                    os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket2.sock")
hide = ["busctl", "--user", "call", "sm.puri.OSK0", "/sm/puri/OSK0",
        "sm.puri.OSK0", "SetVisible", "b", "false"]

while True:
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(sock)
        for line in s.makefile(encoding="utf-8", errors="replace"):
            # "activewindowv2>>" with no address: nothing has focus
            if line.rstrip("\n") in ("activewindowv2>>", "activewindowv2>>,"):
                subprocess.run(hide, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass
    time.sleep(2)  # Hyprland restarting: reconnect
